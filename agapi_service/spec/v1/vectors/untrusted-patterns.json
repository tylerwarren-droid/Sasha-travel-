{
  "version": "1.0-draft.3",
  "rule": "Part 2 §3. A match sets instruction_like: true. The text is kept and shown quoted; nothing is removed for matching. Case-insensitive.",
  "patterns": [
    "ignore (all |any |the )?(previous|prior|above|earlier)",
    "disregard (all |any |the )?(previous|prior|above|earlier)",
    "(^|\\W)(system|assistant|developer)\\s*:",
    "<\\|[^|>]{1,40}\\|>",
    "you are now",
    "new instructions",
    "(javascript|data|vbscript):",
    "\\b(call|invoke|use) (the )?(tool|function)\\b",
    "\\b(send|transfer|wire|pay) (money|funds|\\$|€|£)",
    "\\bbook (the )?(most expensive|all)\\b"
  ]
}
