{
  "version": "kanoe-sandbox-ext.6",
  "note": "Additive only. CR 64: AgAPI 1.1 (EU 211) ADOPTED messages.send_email, messages.send_whatsapp, messages.replies, activity.list, calendar.add_event and sandbox.simulate_reply — they now run on EU's own schemas (spec/v1/schemas/ext/ext.schema.json). The sandbox extensions left: the Keep (CR 63: keep.put, keep.list, keep.use, keep.delete, keep.activity) — proposed to EU.",
  "add": [
    {
      "operation": "keep.put",
      "agent": "austen",
      "idempotent": false,
      "requires_approval": false,
      "input": "https://agapi.kanoe.dev/v1/ext/kanoe-sandbox.schema.json#/$defs/keep_put_in",
      "output": "https://agapi.kanoe.dev/v1/ext/kanoe-sandbox.schema.json#/$defs/keep_put_out",
      "errors": [
        "not_found",
        "invalid_input",
        "upstream_unreachable"
      ],
      "cost_class": "free",
      "extension": true
    },
    {
      "operation": "keep.list",
      "agent": "pacioli",
      "idempotent": false,
      "requires_approval": false,
      "input": "https://agapi.kanoe.dev/v1/ext/kanoe-sandbox.schema.json#/$defs/keep_list_in",
      "output": "https://agapi.kanoe.dev/v1/ext/kanoe-sandbox.schema.json#/$defs/keep_list_out",
      "errors": [
        "not_found",
        "invalid_input"
      ],
      "cost_class": "read",
      "extension": true
    },
    {
      "operation": "keep.use",
      "agent": "austen",
      "idempotent": false,
      "requires_approval": false,
      "input": "https://agapi.kanoe.dev/v1/ext/kanoe-sandbox.schema.json#/$defs/keep_use_in",
      "output": "https://agapi.kanoe.dev/v1/ext/kanoe-sandbox.schema.json#/$defs/keep_use_out",
      "errors": [
        "not_found",
        "invalid_input",
        "already_completed",
        "upstream_unreachable"
      ],
      "cost_class": "free",
      "extension": true
    },
    {
      "operation": "keep.delete",
      "agent": "austen",
      "idempotent": false,
      "requires_approval": false,
      "input": "https://agapi.kanoe.dev/v1/ext/kanoe-sandbox.schema.json#/$defs/keep_delete_in",
      "output": "https://agapi.kanoe.dev/v1/ext/kanoe-sandbox.schema.json#/$defs/keep_delete_out",
      "errors": [
        "not_found",
        "invalid_input"
      ],
      "cost_class": "free",
      "extension": true
    },
    {
      "operation": "keep.activity",
      "agent": "pacioli",
      "idempotent": false,
      "requires_approval": false,
      "input": "https://agapi.kanoe.dev/v1/ext/kanoe-sandbox.schema.json#/$defs/keep_activity_in",
      "output": "https://agapi.kanoe.dev/v1/ext/kanoe-sandbox.schema.json#/$defs/keep_activity_out",
      "errors": [
        "not_found",
        "invalid_input"
      ],
      "cost_class": "read",
      "extension": true
    }
  ]
}
