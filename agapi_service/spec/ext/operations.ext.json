      "operation": "magellan.read_site",
      "agent": "magellan",
      "idempotent": false,
      "requires_approval": false,
      "input": "https://agapi.kanoe.dev/v1/ext/kanoe-sandbox.schema.json#/$defs/read_site_in",
      "output": "https://agapi.kanoe.dev/v1/ext/kanoe-sandbox.schema.json#/$defs/read_site_out",
      "errors": [
        "invalid_input",
        "upstream_unreachable",
        "upstream_refused",
        "upstream_failed",
        "rate_limited",
        "budget_exhausted",
        "unauthenticated",
        "forbidden"
      ],
