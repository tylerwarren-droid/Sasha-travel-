{
  "version": "kanoe-sandbox-ext.3",
  "note": "Additive only. CR 61: approvals.status, webhooks.register and users.verify_destination (and evidence_id on acts.status) were ADOPTED into AgAPI v1.0 (EU 205) — they now run on EU's own schemas; only messages.send_email and calendar.add_event remain sandbox extensions.",
  "add": [
    {
      "operation": "messages.send_email",
      "agent": "austen",
      "idempotent": true,
      "requires_approval": true,
      "input": "https://agapi.kanoe.dev/v1/ext/kanoe-sandbox.schema.json#/$defs/send_email_in",
      "output": "https://agapi.kanoe.dev/v1/ext/kanoe-sandbox.schema.json#/$defs/send_email_out",
      "errors": [
        "approval_required",
        "approval_not_found",
        "approval_same_turn",
        "approval_expired",
        "approval_void",
        "approval_consumed",
        "approval_untrusted_origin",
        "no_explicit_yes",
        "idempotency_key_required",
        "idempotency_in_flight",
        "idempotency_conflict",
        "not_found",
        "invalid_input",
        "upstream_unreachable",
        "upstream_refused",
        "outcome_unknown"
      ],
      "cost_class": "message",
      "extension": true
    },
    {
      "operation": "calendar.add_event",
      "agent": "pacioli",
      "idempotent": false,
      "requires_approval": false,
      "input": "https://agapi.kanoe.dev/v1/ext/kanoe-sandbox.schema.json#/$defs/add_event_in",
      "output": "https://agapi.kanoe.dev/v1/ext/kanoe-sandbox.schema.json#/$defs/add_event_out",
      "errors": [
        "not_found",
        "invalid_input"
      ],
      "cost_class": "free",
      "extension": true
    }
  ]
}