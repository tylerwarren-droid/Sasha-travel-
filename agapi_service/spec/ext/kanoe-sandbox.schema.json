{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agapi.kanoe.dev/v1/ext/kanoe-sandbox.schema.json",
  "title": "Kanoe sandbox extensions to AgAPI v1 (CR 59) — ADDITIVE ONLY, proposed to EU",
  "$defs": {
    "approvals_status_in": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_back_id"
      ],
      "properties": {
        "read_back_id": {
          "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/read_back_id"
        }
      }
    },
    "approvals_status_out": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_back_id",
        "read_back_state",
        "approval"
      ],
      "description": "Finding 3: a partner learns the Approval after a real tap without a webhook. approval is null until the end user said yes.",
      "properties": {
        "read_back_id": {
          "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/read_back_id"
        },
        "read_back_state": {
          "enum": [
            "created",
            "presented",
            "approved",
            "expired",
            "void"
          ]
        },
        "presented_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/timestamp"
            }
          ]
        },
        "approval": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "approval_id",
                "state",
                "approved_at",
                "method",
                "channel",
                "expires_at"
              ],
              "properties": {
                "approval_id": {
                  "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/approval_id"
                },
                "state": {
                  "enum": [
                    "valid",
                    "consumed",
                    "expired",
                    "void"
                  ]
                },
                "approved_at": {
                  "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/timestamp"
                },
                "method": {
                  "enum": [
                    "tap",
                    "voice",
                    "signature"
                  ]
                },
                "channel": {
                  "enum": [
                    "link",
                    "sdk",
                    "sasha_voice",
                    "sasha_chat",
                    "sandbox_simulated"
                  ]
                },
                "expires_at": {
                  "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/timestamp"
                },
                "void_reason": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "status_out": {
      "description": "EU status_out + evidence_id per act (CR 59, additive: an optional field). Part 1 §5.1 R4: an unreadable upstream is an error, never an empty list.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acts",
        "coverage"
      ],
      "properties": {
        "acts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "act_id",
              "intent_id",
              "outcome",
              "updated_at"
            ],
            "properties": {
              "act_id": {
                "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/act_id"
              },
              "intent_id": {
                "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/intent_id"
              },
              "outcome": {
                "$ref": "https://agapi.kanoe.dev/v1/schemas/tools/tools.schema.json#/$defs/act_outcome"
              },
              "updated_at": {
                "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/timestamp"
              },
              "evidence_id": {
                "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/evidence_id"
              }
            }
          }
        },
        "coverage": {
          "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/coverage"
        }
      }
    },
    "webhooks_register_in": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 500
        }
      }
    },
    "webhooks_register_out": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint_id",
        "url",
        "secret",
        "created_at"
      ],
      "description": "Finding 5. The whsec_ secret appears in THIS response only (W3); at most 2 active endpoints per account.",
      "properties": {
        "endpoint_id": {
          "type": "string",
          "pattern": "^wep_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "url": {
          "type": "string"
        },
        "secret": {
          "type": "string",
          "pattern": "^whsec_"
        },
        "created_at": {
          "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/timestamp"
        }
      }
    },
    "users_verify_destination_in": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "end_user_id",
        "channel",
        "value",
        "code"
      ],
      "description": "Finding 5: the end user's one-time code, relayed by the partner's app (the key-less page /v/{token} stays).",
      "properties": {
        "end_user_id": {
          "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/end_user_id"
        },
        "channel": {
          "enum": [
            "sms",
            "whatsapp",
            "email"
          ]
        },
        "value": {
          "type": "string",
          "maxLength": 320
        },
        "code": {
          "type": "string",
          "pattern": "^[0-9]{6}$"
        }
      }
    }
  }
}