{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agapi.kanoe.dev/v1/schemas/error.schema.json",
  "title": "AgAPI v1 error body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message",
    "retryable"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "A code from error-codes.json (or a registered domain code, Part 2)."
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence a person can read. No secrets, stack traces or upstream bodies."
    },
    "retryable": {
      "type": "boolean"
    },
    "retry_after_s": {
      "type": "integer",
      "minimum": 1
    },
    "details": {
      "type": "object"
    }
  }
}
