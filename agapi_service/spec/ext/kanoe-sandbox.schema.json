{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agapi.kanoe.dev/v1/ext/kanoe-sandbox.schema.json",
  "title": "Kanoe sandbox extensions to AgAPI v1.0 (CR 60) — ADDITIVE ONLY: messages.send_email, calendar.add_event",
  "$defs": {
    "send_email_in": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "end_user",
        "to",
        "subject",
        "body"
      ],
      "description": "CR 60: from Sasha's own sending address (never the user's mailbox) to one person the user names. approval_id and idempotency_key are envelope fields.",
      "properties": {
        "end_user": {
          "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/end_user_id"
        },
        "to": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "address"
          ],
          "properties": {
            "address": {
              "type": "string",
              "maxLength": 254
            },
            "name": {
              "type": "string",
              "maxLength": 120
            }
          }
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        }
      }
    },
    "send_email_out": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "act_id",
        "intent_id",
        "outcome",
        "evidence_id",
        "message"
      ],
      "properties": {
        "act_id": {
          "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/act_id"
        },
        "intent_id": {
          "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/intent_id"
        },
        "outcome": {
          "$ref": "https://agapi.kanoe.dev/v1/schemas/tools/tools.schema.json#/$defs/act_outcome"
        },
        "evidence_id": {
          "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/evidence_id"
        },
        "message": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to",
            "subject",
            "body_sha256",
            "sent_at"
          ],
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "address"
              ],
              "properties": {
                "address": {
                  "$ref": "https://agapi.kanoe.dev/v1/schemas/tools/tools.schema.json#/$defs/untrusted_text"
                },
                "name": {
                  "$ref": "https://agapi.kanoe.dev/v1/schemas/tools/tools.schema.json#/$defs/untrusted_text"
                }
              }
            },
            "subject": {
              "type": "string"
            },
            "body_sha256": {
              "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/sha256"
            },
            "sent_at": {
              "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/timestamp"
            }
          }
        }
      }
    },
    "add_event_in": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "act_id"
      ],
      "description": "CR 60: a CONFIRMED act (a flight, a table, a stay) as a calendar event. No Approval: nothing leaves the user's account.",
      "properties": {
        "act_id": {
          "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/act_id"
        }
      }
    },
    "add_event_out": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "event_sha256",
        "ics",
        "links",
        "evidence_id"
      ],
      "properties": {
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uid",
            "title",
            "starts_at",
            "ends_at"
          ],
          "properties": {
            "uid": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "starts_at": {
              "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/timestamp"
            },
            "ends_at": {
              "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/timestamp"
            },
            "location": {
              "type": "string"
            },
            "details": {
              "type": "string"
            }
          }
        },
        "event_sha256": {
          "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/sha256"
        },
        "ics": {
          "type": "string"
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "google",
            "outlook",
            "apple",
            "ics"
          ],
          "properties": {
            "google": {
              "type": "string",
              "format": "uri"
            },
            "outlook": {
              "type": "string",
              "format": "uri"
            },
            "apple": {
              "type": "string",
              "format": "uri"
            },
            "ics": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "evidence_id": {
          "$ref": "https://agapi.kanoe.dev/v1/schemas/common.schema.json#/$defs/evidence_id"
        }
      }
    }
  }
}