            "body_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "sent_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$",
              "description": "RFC 3339, UTC, 'Z' suffix."
            }
          }
        }
      }
