                    }
                  }
                },
                "name": {
                  "description": "Part 2 §3. Every human-language string that came from outside AgAPI is wrapped in this object.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "text",
                    "source",
                    "retrieved_at"
                  ],
                  "properties": {
                    "text": {
                      "type": "string",
                      "maxLength": 2000,
